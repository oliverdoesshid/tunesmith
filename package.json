{
  "name": "tunesmith",
  "productName": "TuneSmith",
  "version": "0.2.0",
  "private": true,
  "description": "Windows performance tuning driven by community presets, with a closed action vocabulary and mandatory rollback.",
  "author": "TuneSmith Contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.cjs",
  "bin": {
    "tunesmith-cli": "dist/cli/index.cjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "build": "node scripts/build.mjs",
    "cli": "node dist/cli/index.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "detect": "node scripts/detect.mjs",
    "presets:hash": "node scripts/hash-presets.mjs",
    "market:index": "node scripts/run-market-index.mjs",
    "market:check": "node scripts/run-market-index.mjs --check",
    "build:win": "electron-builder --win --x64",
    "package": "npm run build && npm run build:win"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "dev.tunesmith.app",
    "productName": "TuneSmith",
    "copyright": "Copyright © 2026 TuneSmith Contributors",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "oliverdoesshid",
        "repo": "tunesmith",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "dist/cli/**/*",
      "presets/**/*",
      "package.json",
      "LICENSE",
      "!**/*.map",
      "!**/*.d.ts",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TuneSmith",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "differentialPackage": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
